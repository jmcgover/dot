# browser
browser "/usr/bin/open \"/Applications/Google Chrome.app\" %u"

always-display-description yes
auto-reload yes
text-width 72
datetime-format "%Y-%m-%dT%H:%M:%S%Z"

# unbind keys
unbind-key ENTER
unbind-key j
unbind-key k
unbind-key J
unbind-key K

# bind keys - vim style
bind-key j down
bind-key k up
bind-key l open
bind-key h quit
