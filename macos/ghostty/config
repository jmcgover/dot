### VERSION ###
auto-update=check
auto-update-channel=tip

### FONT ###
# ghostty +list-fonts
font-family="Osaka"
#font-family="Menlo"
#font-size=11
# bold-is-bright: bold text uses bright color palette
bold-is-bright=true

### THEME ###
# List with `ghostty +list-themes`
theme="AlienBloodMine"
#theme="Everforest Dark Hard"
#theme="Kanagawa Wave"
#theme="nord"

### CONTRAST ###
# If you want to avoid invisible text (same color as background), a value of 1.1 is a good value.
# If you want to avoid text that is difficult to read, a value of 3 or higher is a good value.
# The higher the value, the more likely that text will become black or white.
minimum-contrast=3

### ICON ###
# macos-icon: official, blueprint, chalkboard, microchip, glass, holographic, paper, retro, xray
macos-icon=holographic

### WORKDIR ###
window-inherit-working-directory=false
tab-inherit-working-directory = false
split-inherit-working-directory = true
working-directory=home

### SHELL ###
shell-integration = bash
